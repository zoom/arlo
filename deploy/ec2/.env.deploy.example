# Copy this file to the repository root as .env.deploy and set mode 0600.
# This file is only a local staging file for uploading secrets to SSM. Never
# copy it to EC2, commit it, or use it as the container environment file.

# Use the Aurora cluster endpoint and a least-privilege application user.
# Percent-encode reserved characters in the password.
# Format: mysql://USER:PASSWORD@AURORA_WRITER_ENDPOINT:3306/DATABASE
DATABASE_URL='REPLACE_ME'

ZOOM_CLIENT_ID='REPLACE_ME'
ZOOM_CLIENT_SECRET='REPLACE_ME'
ZOOM_WEBHOOK_TOKEN='REPLACE_ME'

# Generate each independently with: openssl rand -hex 32
SESSION_SECRET='REPLACE_WITH_64_HEX_CHARACTERS'
TOKEN_ENCRYPTION_KEY='REPLACE_WITH_64_HEX_CHARACTERS'

# Optional. Omit the SSM parameter when this is empty.
OPENROUTER_API_KEY=''
